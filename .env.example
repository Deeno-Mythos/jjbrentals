# Keep these server-only variables out of client-side code.
# Either TURSODB_* or TURSO_* names are accepted by the app.
CLOUD_NAME=your-cloudinary-cloud-name
TURSODB_URL=libsql://your-database.turso.io
TURSODB_API_TOKEN=replace-with-a-database-auth-token
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters-long
